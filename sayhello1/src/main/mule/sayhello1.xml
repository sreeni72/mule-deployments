	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="863b2fd7-261c-45ad-b2ae-813f64188757" >
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>
	<flow name="sayhello1Flow" doc:id="462b3714-1701-4ecc-8249-533ee05e97cb" >
		<http:listener doc:name="Listener" doc:id="b6308255-53df-4da6-92d1-2a425b4eab18" config-ref="HTTP_Listener_config" path="/hello1"/>
		<ee:transform doc:name="Transform Message" doc:id="121fed8f-1093-40f7-8b19-52e8135c4596">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"message": "Hello, How are you !"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
